function createLock(path) {
  let descriptor;
  try {
    descriptor = (0, import_node_fs4.openSync)(path, "wx");
  } catch {
    return null;
  }
  try {
    (0, import_node_fs4.writeSync)(descriptor, `${process.pid} ${Date.now()}
`);
    return descriptor;
  } catch {
    (0, import_node_fs4.closeSync)(descriptor);
    try {
      (0, import_node_fs4.unlinkSync)(path);
    } catch {
    }
    return null;
  }
}
async function withLockWait(path, staleMs, timeoutMs, fn) {
  const deadline = Date.now() + timeoutMs;
  while (true) {
    const result = await withLock(path, staleMs, fn);
    if (result) return result;
    if (Date.now() >= deadline) return null;
    await new Promise((resolve2) => setTimeout(resolve2, Math.min(25, deadline - Date.now())));
  }
}
async function withLock(path, staleMs, fn) {
  let descriptor = createLock(path);
  if (descriptor === null) {
    let stale = false;
    try {
      stale = Date.now() - (0, import_node_fs4.statSync)(path).mtimeMs > staleMs;
    } catch {
      stale = false;
    }
    if (!stale) return null;
    try {
      (0, import_node_fs4.unlinkSync)(path);
    } catch {
      return null;
    }
    descriptor = createLock(path);
    if (descriptor === null) return null;
  }
  (0, import_node_fs4.closeSync)(descriptor);
  try {
    return { value: await fn() };
  } finally {
    try {
      (0, import_node_fs4.unlinkSync)(path);
    } catch {
    }
  }
}

