      message: `${event} \u6307\u5411\u7684\u6587\u4EF6\u4E0D\u5B58\u5728\uFF08${path}\uFF09\uFF0C\u91CD\u65B0\u8FD0\u884C deverdesk-recorder setup --install-codex-hooks`
    }));
  }
  const paths = [...new Set(targets.map((target) => target.path))];
  return [{ status: "pass", label: "Codex \u94A9\u5B50", message: `\u8BB0\u5F55\u5668\u6587\u4EF6\uFF1A${paths.join("\u3001")}` }];
