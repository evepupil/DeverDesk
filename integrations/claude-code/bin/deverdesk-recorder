function defaultResolveFirstLive(home) {
  return readState(home).firstLiveEvent;
}
async function runBackfill(options, dependencies) {
  if (!Number.isSafeInteger(options.days) || options.days < 1) throw new Error("--days \u5FC5\u987B\u662F\u6B63\u6574\u6570");
  const now = dependencies.now ?? Date.now();
  const home = dependencies.home ?? recorderHome(dependencies.env);
  const since = now - options.days * DAY_MS2;
  const firstLive = (dependencies.readFirstLive ?? defaultResolveFirstLive)(home);
  const git = dependencies.git ?? createGitRunner();
  const resolveDir = dependencies.resolveDir ?? createDirNameResolver(git, dependencies.pathExists ?? (async (path) => (0, import_node_fs8.existsSync)(path)));
  const findCommits = dependencies.findCommits ?? createCommitFinder(git);
  const env = dependencies.env;
  const promptTextAllowed = isPromptTextAllowed(home, env);
  const selected = options.agent === "all" ? ["claude-code", "codex"] : [options.agent];
  const existing = (dependencies.readEvents ?? readEvents)(home, { now });
  const identities = new Set(existing.map(eventIdentity));
  const reports = [];
  for (const agent of selected) {
    const stats = emptyStats();
    const agentOptions = {
      root: agent === "claude-code" ? (0, import_node_path9.join)(env.CLAUDE_CONFIG_DIR || (0, import_node_path9.join)((0, import_node_os2.homedir)(), ".claude"), "projects") : (0, import_node_path9.join)(env.CODEX_HOME || (0, import_node_path9.join)((0, import_node_os2.homedir)(), ".codex"), "sessions"),
      since,
      until: firstLive[agent] ?? Number.POSITIVE_INFINITY,
      resolveDir,
      findCommits
    };
    const generate = agent === "claude-code" ? dependencies.backfillClaudeCode ?? backfillClaudeCode : dependencies.backfillCodex ?? backfillCodex;
    let added = 0;
    const pendingEvents = [];
    for await (const event of generate(agentOptions, stats)) {
      const storedEvent = event.kind === "prompt" && !promptTextAllowed ? withoutPromptText(event) : event;
      const identity = eventIdentity(storedEvent);
      if (identities.has(identity)) continue;
      identities.add(identity);
      added += 1;
      pendingEvents.push(storedEvent);
    }
    if (!options.dryRun) {
      for (const event of pendingEvents) (dependencies.appendEvent ?? appendEvent)(home, event);
    }
    reports.push(`${agent}\uFF1A\u6587\u4EF6 ${stats.files}\uFF0C\u4F1A\u8BDD ${stats.sessions}\uFF0C\u4E8B\u4EF6 ${added}${stats.skippedFiles ? `\uFF0C\u8DF3\u8FC7\u6587\u4EF6 ${stats.skippedFiles}` : ""}`);
  }
  const heading = options.dryRun ? "\u56DE\u586B\u9884\u89C8" : "\u56DE\u586B\u5B8C\u6210";
  return `${heading}
${reports.join("\n")}
\u8FD0\u884C deverdesk-recorder sync \u4E0A\u4F20\u5DF2\u7ED1\u5B9A\u76EE\u5F55\u7684\u8BB0\u5F55\u3002`;
}

