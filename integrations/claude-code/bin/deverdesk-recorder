function loadCredentials(home, env = process.env) {
  const candidates = [
    { url: env.DEVERDESK_URL, token: env.DEVERDESK_TOKEN, source: "env" },
    { url: env.CLAUDE_PLUGIN_OPTION_SERVER_URL, token: env.CLAUDE_PLUGIN_OPTION_TOKEN, source: "plugin" }
  ];
  for (const candidate of candidates) {
    const credentials = normalizeCredentials(candidate.url, candidate.token, candidate.source);
    if (credentials) return credentials;
  }
  try {
    const config = JSON.parse((0, import_node_fs9.readFileSync)((0, import_node_path10.join)(home, "config.json"), "utf8"));
    if (!isRecord4(config)) return null;
    return normalizeCredentials(config.url, config.token, "config");
  } catch {
    return null;
  }
}
