function managedRecorderPathFromCommand(command) {
  if (!isManagedRecorderCommand(command)) return void 0;
  const match = /(?:"([^"]+)"|'([^']+)'|(\S+))\s+hook\s+codex\s+\S+/iu.exec(command);
