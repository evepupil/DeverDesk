// integrations/recorder/src/core/project-name.ts
function dirNameFromFacts(cwd, facts) {
  const commonDir = normalizePath(facts.commonDir ?? "");
  const toplevel = normalizePath(facts.toplevel ?? "");
  if (facts.bare && commonDir) return pathName(commonDir).replace(/\.git$/i, "");
  if (facts.superproject?.trim() && toplevel) return pathName(toplevel);
  if (/(?:^|\/)\.git$/i.test(commonDir)) return pathName(parentPath(commonDir));
  if (commonDir) return pathName(commonDir).replace(/\.git$/i, "");
  return dirNameFromPath(cwd);
}
function dirNameFromPath(cwd) {
  const normalized = normalizePath(cwd);
  if (!normalized) return "";
  if (/^[a-z]:\/?$/i.test(normalized)) return normalized.slice(0, 2);
  const parts = normalized.split("/").filter(Boolean);
  if (parts.length >= 3 && parts[parts.length - 3]?.toLowerCase() === ".claude" && parts[parts.length - 2]?.toLowerCase() === "worktrees") {
    parts.splice(-3);
  }
  return parts[parts.length - 1] ?? "";
}
function normalizePath(path) {
  return path.replace(/\\/g, "/").replace(/\/+$/, "");
}
function pathName(path) {
  const normalized = normalizePath(path);
  if (!normalized) return "";
  if (/^[a-z]:$/i.test(normalized)) return normalized;
  const parts = normalized.split("/").filter(Boolean);
  return parts[parts.length - 1] ?? "";
}
function parentPath(path) {
  const normalized = normalizePath(path);
  const slash = normalized.lastIndexOf("/");
  if (slash < 0) return "";
  if (slash === 2 && /^[a-z]:\//i.test(normalized)) return normalized.slice(0, 3);
  if (slash === 0) return "/";
  return normalized.slice(0, slash);
}

// integrations/recorder/src/git/resolve-project.ts
async function resolveDirName(cwd, git, options = {}) {
  const cached = options.cache?.get(cwd);
  if (cached) return cached;
  const common = await git.run(
    ["-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir", "--is-bare-repository"],
    cwd
  );
  if (!common.ok) return cacheResult(cwd, { dir: dirNameFromPath(cwd) }, options.cache);
  const lines = common.stdout.split(/\r?\n/);
  const commonDir = lines[0]?.trim();
  const bareText = lines[1]?.trim();
  if (!commonDir || bareText !== "true" && bareText !== "false") {
    return cacheResult(cwd, { dir: dirNameFromPath(cwd) }, options.cache);
  }
  const normalizedCommonDir = normalizePath2(commonDir);
  const facts = {
    commonDir: normalizedCommonDir,
    bare: bareText === "true"
  };
  if (!facts.bare) {
    const top = await git.run(["-C", cwd, "rev-parse", "--show-toplevel"], cwd);
    if (top.ok && top.stdout.trim()) facts.toplevel = normalizePath2(top.stdout.trim());
  }
  if (!normalizedCommonDir.endsWith("/.git")) {
    const parent = await git.run(["-C", cwd, "rev-parse", "--show-superproject-working-tree"], cwd);
    if (parent.ok && parent.stdout.trim()) facts.superproject = normalizePath2(parent.stdout.trim());
  }
  const bareWorktreeCommonDir = await findBareWorktreeCommonDir(git, cwd, facts, normalizedCommonDir);
  const dir = bareWorktreeCommonDir ? dirNameFromFacts(cwd, { ...facts, commonDir: bareWorktreeCommonDir, bare: true }) : isSeparateGitDirWorktree(facts, normalizedCommonDir) ? import_node_path.posix.basename(facts.toplevel ?? "") : dirNameFromFacts(cwd, facts);
  let repo;
  if (facts.bare) repo = normalizedCommonDir;
  else if (facts.superproject) repo = facts.toplevel;
  else if (normalizedCommonDir.endsWith("/.git")) repo = normalizePath2((0, import_node_path.dirname)(normalizedCommonDir));
  else repo = facts.toplevel;
  return cacheResult(cwd, repo ? { dir, repo } : { dir }, options.cache);
}
function createDirNameResolver(git, pathExists) {
  return async (cwd) => {
    if (!await pathExists(cwd)) return { dir: dirNameFromPath(cwd) };
    return resolveDirName(cwd, git);
  };
}
async function findBareWorktreeCommonDir(git, cwd, facts, commonDir) {
  if (facts.bare || !facts.toplevel || commonDir.endsWith("/.git")) return void 0;
  const match = /^(.*)\/worktrees\/[^/]+$/i.exec(commonDir);
  const root = match?.[1] ?? commonDir;
  try {
    if (!(0, import_node_fs.statSync)((0, import_node_path.join)(facts.toplevel, ".git")).isFile()) return void 0;
  } catch {
    return void 0;
  }
  const result = await git.run(["-C", cwd, "config", "--bool", "core.bare"], cwd);
  return result.ok && result.stdout.trim() === "true" ? root : void 0;
}
function isSeparateGitDirWorktree(facts, commonDir) {
  if (facts.bare || facts.superproject || !facts.toplevel || commonDir.endsWith("/.git")) return false;
  try {
    return (0, import_node_fs.statSync)((0, import_node_path.join)(facts.toplevel, ".git")).isFile();
  } catch {
    return false;
  }
}
function cacheResult(cwd, result, cache) {
  cache?.set(cwd, result);
  return result;
}
function normalizePath2(value) {
  const normalized = value.replace(/\\/g, "/").replace(/\/+$/, "");
  return normalized || import_node_path.posix.parse(value.replace(/\\/g, "/")).root;
}

// integrations/recorder/src/git/runner.ts
var import_node_child_process = require("node:child_process");
var MAX_BUFFER = 8 * 1024 * 1024;
function createGitRunner() {
  return {
    run(args, cwd, options = {}) {
      return new Promise((resolve2) => {
        const stdout = [];
        const stderr = [];
        let stdoutBytes = 0;
        let stderrBytes = 0;
        let settled = false;
        let child;
        const output = (chunks) => Buffer.concat(chunks).toString("utf8");
        const finish = (ok, message) => {
          if (settled) return;
          settled = true;
          if (timer) clearTimeout(timer);
          const errorOutput = output(stderr);
          resolve2({
            ok,
            stdout: output(stdout),
            stderr: [errorOutput, message].filter(Boolean).join("\n")
          });
        };
        const stop = (message) => {
          try {
            child?.kill();
          } catch {
          }
          finish(false, message);
        };
        const timer = setTimeout(() => stop(`git timed out after ${options.timeoutMs ?? 5e3} ms`), options.timeoutMs ?? 5e3);
        const collect = (chunks, current, chunk, assign) => {
          const remaining = MAX_BUFFER - current;
          if (remaining > 0) chunks.push(chunk.subarray(0, remaining));
          const next = current + Math.min(chunk.length, Math.max(remaining, 0));
          assign(next);
          return chunk.length > remaining;
        };
        try {
          child = (0, import_node_child_process.spawn)("git", args, { cwd, windowsHide: true, stdio: ["ignore", "pipe", "pipe"] });
        } catch (error) {
          finish(false, error instanceof Error ? error.message : String(error));
          return;
        }
        const spawned = child;
        if (!spawned?.stdout || !spawned.stderr) {
          finish(false, "git spawn did not create output streams");
          return;
        }
        spawned.stdout.on("data", (value) => {
          if (settled) return;
          const chunk = Buffer.isBuffer(value) ? value : Buffer.from(value);
          if (collect(stdout, stdoutBytes, chunk, (count) => {
            stdoutBytes = count;
          })) stop(`git stdout exceeded ${MAX_BUFFER} bytes`);
        });
        spawned.stderr.on("data", (value) => {
          if (settled) return;
          const chunk = Buffer.isBuffer(value) ? value : Buffer.from(value);
          if (collect(stderr, stderrBytes, chunk, (count) => {
            stderrBytes = count;
          })) stop(`git stderr exceeded ${MAX_BUFFER} bytes`);
        });
        spawned.stdout.on("error", (error) => stop(`git stdout failed: ${error.message}`));
        spawned.stderr.on("error", (error) => stop(`git stderr failed: ${error.message}`));
        spawned.on("error", (error) => finish(false, `git spawn failed: ${error.message}`));
        spawned.on("close", (code) => finish(code === 0));
      });
    }
  };
}

