// integrations/recorder/src/core/constants.ts
var MINUTE = 6e4;
var PRESENCE_GAP = 15 * MINUTE;
var AI_ALONE_CAP = 15 * MINUTE;
var IDLE_ARRIVAL = 2 * 60 * MINUTE;
var BURST_GAP = 2 * MINUTE;
var MICRO_TASK = 3 * MINUTE;
var MERGE_WINDOW = 2 * 60 * MINUTE;
var MIN_ENTRY = 0.5 * MINUTE;
