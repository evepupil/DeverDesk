var DAY_MS = 24 * 60 * 60 * 1e3;
function parseCodexRow(line) {
  if (!line.includes('"type":"session_meta"') && !line.includes('"type":"event_msg"')) return void 0;
  let value;
  try {
    value = JSON.parse(line);
  } catch {
    return void 0;
  }
  if (!isRecord(value) || typeof value.type !== "string") return void 0;
  const payload = isRecord(value.payload) ? value.payload : void 0;
  const metadataId = payload?.id;
  const aliasId = payload?.session_id;
  const sessionId = typeof metadataId === "string" && metadataId.length > 0 ? metadataId : typeof aliasId === "string" && aliasId.length > 0 ? aliasId : void 0;
  const timestamp = typeof value.timestamp === "string" ? Date.parse(value.timestamp) : Number.NaN;
  return {
    type: value.type,
    timestamp: Number.isFinite(timestamp) ? timestamp : void 0,
    sessionId,
    cwd: typeof payload?.cwd === "string" ? payload.cwd : void 0,
    eventType: typeof payload?.type === "string" ? payload.type : void 0
  };
}
function dateFromFilename(filePath) {
  const match = /^rollout-(\d{4}-\d{2}-\d{2})/.exec((0, import_node_path5.basename)(filePath));
  if (!match?.[1]) return void 0;
  const dateText = match[1];
  const date = Date.parse(`${dateText}T00:00:00.000Z`);
  if (!Number.isFinite(date) || new Date(date).toISOString().slice(0, 10) !== dateText) return void 0;
  return date;
}
function filenameSessionId(filePath) {
  const match = /-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$/i.exec((0, import_node_path5.basename)(filePath));
  return match?.[1];
}
function olderThanSince(filePath, since) {
  const fileDate = dateFromFilename(filePath);
  if (fileDate === void 0) return false;
  const sinceDay = Math.floor(since / DAY_MS) * DAY_MS;
  return fileDate < sinceDay - DAY_MS;
}
async function listCodexFiles(root, stats) {
  const files = [];
  async function walk(directory, depth) {
    let entries;
    try {
      entries = await (0, import_promises2.readdir)(directory, { withFileTypes: true });
    } catch {
      if (depth === 0) stats.skippedFiles += 1;
      return;
    }
    for (const entry of entries) {
      const path = (0, import_node_path5.join)(directory, entry.name);
      if (depth < 3 && entry.isDirectory()) {
        await walk(path, depth + 1);
      } else if (depth === 3 && entry.isFile() && entry.name.startsWith("rollout-") && entry.name.endsWith(".jsonl")) {
        files.push(path);
      }
    }
  }
  await walk(root, 0);
  return files.sort();
}
async function scanCodexFile(filePath) {
  const fallbackId = filenameSessionId(filePath);
  let sessionId;
  let cwd;
  let cwdAt;
  let startAt;
  let activityEndAt;
  for await (const line of readJsonlLines(filePath)) {
    const row = parseCodexRow(line);
    if (!row) continue;
    if (row.type === "session_meta" && row.sessionId) sessionId = row.sessionId;
    if (row.cwd !== void 0) {
      if (row.timestamp !== void 0 && (cwdAt === void 0 || row.timestamp < cwdAt)) {
        cwd = row.cwd;
        cwdAt = row.timestamp;
      } else if (row.timestamp === void 0 && cwd === void 0) {
        cwd = row.cwd;
      }
    }
    if (row.timestamp !== void 0) {
      startAt = startAt === void 0 ? row.timestamp : Math.min(startAt, row.timestamp);
      activityEndAt = activityEndAt === void 0 ? row.timestamp : Math.max(activityEndAt, row.timestamp);
    }
  }
  if (!cwd) throw new Error("Codex session has no cwd");
  const id = sessionId || fallbackId;
  if (!id) throw new Error("Codex session has no id");
  return { session: id, cwd, cwdAt, dir: "", startAt, activityEndAt };
}
function mergeSession2(target, next) {
  const current = target.get(next.session);
  if (!current) {
    target.set(next.session, next);
    return;
  }
  if (next.cwdAt !== void 0 && (current.cwdAt === void 0 || next.cwdAt < current.cwdAt)) {
    current.cwd = next.cwd;
    current.cwdAt = next.cwdAt;
  } else if (next.cwdAt === void 0 && !current.cwd) {
    current.cwd = next.cwd;
  }
  if (next.startAt !== void 0) current.startAt = current.startAt === void 0 ? next.startAt : Math.min(current.startAt, next.startAt);
  if (next.activityEndAt !== void 0) {
    current.activityEndAt = current.activityEndAt === void 0 ? next.activityEndAt : Math.max(current.activityEndAt, next.activityEndAt);
  }
}
async function* backfillCodex(options, stats) {
