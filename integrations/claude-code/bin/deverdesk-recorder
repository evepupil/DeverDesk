function isPromptTextAllowed(home, env) {
  if (env.DEVERDESK_NO_PROMPT_TEXT === "1") return false;
  try {
    const config = JSON.parse((0, import_node_fs7.readFileSync)((0, import_node_path8.join)(home, "config.json"), "utf8"));
    if (isRecord3(config) && isRecord3(config.privacy) && config.privacy.promptText === false) return false;
  } catch {
  }
  return true;
}
function isRecord3(value) {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

// integrations/recorder/src/commands/backfill.ts
var DAY_MS2 = 24 * 60 * 60 * 1e3;
function emptyStats() {
  return { files: 0, sessions: 0, events: 0, skippedFiles: 0 };
}
function withoutPromptText(event) {
  const safe = { ...event };
  delete safe.text;
  return safe;
}
function eventIdentity(event) {
  return `${event.session}|${event.kind}|${event.t}`;
