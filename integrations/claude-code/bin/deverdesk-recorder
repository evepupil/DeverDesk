    if (!isRecord2(state.sessionStarts)) state.sessionStarts = {};
    return state;
  } catch {
    return emptyState();
  }
}
function readUploadedKeys(home) {
  const done = /* @__PURE__ */ new Set();
  const rejected = /* @__PURE__ */ new Map();
  let contents;
  try {
    contents = (0, import_node_fs5.readFileSync)((0, import_node_path6.join)(home, "uploaded.jsonl"), "utf8");
  } catch {
    return { done, rejected };
  }
  for (const line of contents.split(/\r?\n/)) {
    if (!line) continue;
