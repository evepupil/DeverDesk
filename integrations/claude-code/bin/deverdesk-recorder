async function updateStateInternal(home, fn) {
  (0, import_node_fs5.mkdirSync)(home, { recursive: true });
  const lockPath = (0, import_node_path6.join)(home, "state.lock");
  const result = await withLockWait(lockPath, 1e4, 3e3, async () => {
    cleanStateTemps(home);
    const state = readState(home);
    const changed = await fn(state);
    const next = changed ?? state;
    await writeState(home, next);
    return next;
  });
  if (result) return result.value;
  logStateFailure(home, "Could not acquire state.lock within 3 seconds; state update skipped");
  return readState(home);
}
function readState(home) {
