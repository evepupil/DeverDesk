    home: recorderHome(env),
    cwd: process.cwd(),
    env,
    now,
    resolveDirName: (cwd) => resolveDirName(cwd, git),
    readEvents,
    appendEvent,
    spawnBackgroundSync: () => {
      const child = (0, import_node_child_process3.spawn)(process.execPath, [script, "sync"], {
        detached: true,
        stdio: "ignore",
        windowsHide: true,
        env: { ...env, DEVERDESK_RECORDER_INTERNAL: "1" }
      });
