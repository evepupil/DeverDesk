var CACHE_TTL_MS = 10 * 6e4;
var BRIEFING_BUDGET_MS = 800;
async function fetchBriefing(credentials, dir, options = {}) {
  const home = options.home ?? recorderHome();
  const now = options.now ?? Date.now();
  const key = dir.toLowerCase();
  try {
    const cache = readCache(home);
    const cached = cache[key];
    if (cached && now >= cached.at && now - cached.at < CACHE_TTL_MS) return cached.response;
    const url = new URL(`${credentials.url.replace(/\/+$/, "")}/api/recorder/briefing?dir=${encodeURIComponent(dir)}`);
    const payload = await requestBriefing(url, credentials.token, options.timeoutMs ?? BRIEFING_BUDGET_MS);
    if (!isBriefingResponse(payload)) return null;
    cache[key] = { at: now, response: payload };
    (0, import_node_fs12.mkdirSync)(home, { recursive: true });
    (0, import_node_fs12.writeFileSync)((0, import_node_path13.join)(home, "briefing-cache.json"), `${JSON.stringify(cache)}
`, { encoding: "utf8", mode: 384 });
    return payload;
  } catch {
    return null;
  }
}
function requestBriefing(url, token, timeoutMs) {
  if (url.protocol !== "http:" && url.protocol !== "https:") return Promise.resolve(null);
  return new Promise((resolve2) => {
    let settled = false;
    let timeout;
    const finish = (value) => {
      if (settled) return;
      settled = true;
      if (timeout) clearTimeout(timeout);
      resolve2(value);
    };
    const onResponse = (response) => {
      if (response.statusCode === void 0 || response.statusCode < 200 || response.statusCode >= 300) {
        response.destroy();
        finish(null);
        return;
      }
      response.setEncoding("utf8");
      let body = "";
      response.on("data", (chunk) => {
        body += chunk;
      });
      response.once("aborted", () => finish(null));
      response.once("error", () => finish(null));
      response.once("end", () => {
        if (!response.complete) {
          finish(null);
          return;
        }
        try {
          finish(JSON.parse(body));
        } catch {
          finish(null);
        }
      });
    };
    try {
      const options = { method: "GET", headers: { Authorization: `Bearer ${token}` } };
      const request = url.protocol === "https:" ? (0, import_node_https.request)(url, options, onResponse) : (0, import_node_http.request)(url, options, onResponse);
      request.once("error", () => finish(null));
      timeout = setTimeout(() => {
        finish(null);
        request.destroy();
      }, timeoutMs);
      request.end();
    } catch {
      finish(null);
    }
  });
}
function formatBriefing(briefing) {
  if (!briefing.bound) return "";
  const extended = briefing;
  const more = extended.more ?? { plannedToday: 0, overdue: 0, open: 0 };
  const blocks = [];
  if (briefing.project) {
    blocks.push(`DeverDesk \xB7 \u526F\u4E1A\u300C${briefing.project.name}\u300D\uFF08${stageLabel(briefing.project.stage)}\uFF09`);
  }
  const shown = /* @__PURE__ */ new Set();
  const countLabel = (count) => count > 0 ? `\uFF08\u53E6\u6709 ${count} \u9879\uFF09` : "";
  if (briefing.plannedToday.length > 0 || more.plannedToday > 0) {
    blocks.push(`\u4ECA\u5929\u8BA1\u5212${countLabel(more.plannedToday)}\uFF1A${briefing.plannedToday.map((task) => {
      shown.add(task.code);
      return `${task.code} ${task.title}\uFF08${task.estimateMin}m\uFF0C${priorityLabel(task.priority)}\uFF09`;
    }).join("\uFF1B")}`);
  }
  if (briefing.overdue.length > 0 || more.overdue > 0) {
    blocks.push(`\u5DF2\u903E\u671F${countLabel(more.overdue)}\uFF1A${briefing.overdue.map((task) => {
      shown.add(task.code);
      return `${task.code} ${task.title}${task.dueOn ? `\uFF08\u622A\u6B62 ${task.dueOn.slice(5)}\uFF09` : ""}`;
    }).join("\uFF1B")}`);
  }
  const otherOpen = briefing.open.filter((task) => !shown.has(task.code)).slice(0, 15);
  if (otherOpen.length > 0 || more.open > 0) {
    blocks.push(`\u5176\u4ED6\u6CA1\u505A\u5B8C\u7684${countLabel(more.open)}\uFF1A${otherOpen.map((task) => `${task.code} ${task.title}`).join("\uFF1B")}`);
  }
  const reminder = "\u63D0\u4EA4\u8BF4\u660E\u91CC\u5199 Closes T-141 \u4E4B\u7C7B\u7684\u7F16\u53F7\uFF0C\u8FD9\u6B21\u63D0\u4EA4\u5C31\u4F1A\u628A\u90A3\u4E2A\u4EFB\u52A1\u6807\u6210\u5B8C\u6210\uFF1B\u6CA1\u5199\u7F16\u53F7\u7684\u63D0\u4EA4\u4F1A\u81EA\u52A8\u8BB0\u6210\u65B0\u4EFB\u52A1\u3002";
  const notice = "\u7B80\u62A5\u6709\u5185\u5BB9\u672A\u663E\u793A";
  const selected = [];
  const lengthOf = (lines) => Array.from(lines.join("\n")).length;
  let truncated = false;
  for (const block of blocks) {
    if (lengthOf([...selected, block, reminder]) <= 1200) selected.push(block);
    else truncated = true;
  }
  if (truncated) {
    while (selected.length > 0 && lengthOf([...selected, notice, reminder]) > 1200) selected.pop();
    return [...selected, notice, reminder].join("\n");
  }
  return [...selected, reminder].join("\n");
}
function readCache(home) {
  try {
    const value = JSON.parse((0, import_node_fs12.readFileSync)((0, import_node_path13.join)(home, "briefing-cache.json"), "utf8"));
    if (!isRecord9(value)) return {};
    const entries = {};
    for (const [key, item] of Object.entries(value)) {
      if (!isRecord9(item) || typeof item.at !== "number" || !isBriefingResponse(item.response)) continue;
      entries[key] = { at: item.at, response: item.response };
    }
    return entries;
  } catch {
    return {};
  }
}
function isBriefingResponse(value) {
  if (!isRecord9(value) || typeof value.bound !== "boolean" || typeof value.today !== "string") return false;
  if (!Array.isArray(value.plannedToday) || !value.plannedToday.every(isBriefingTask)) return false;
  if (!Array.isArray(value.overdue) || !value.overdue.every(isBriefingTask)) return false;
  if (!Array.isArray(value.open) || !value.open.every(isBriefingTask)) return false;
  if (value.more !== void 0 && !isBriefingMore(value.more)) return false;
  if (value.project === void 0) return true;
  return isRecord9(value.project) && typeof value.project.id === "string" && typeof value.project.name === "string" && typeof value.project.stage === "string" && ["idea", "building", "running", "paused", "ended"].includes(value.project.stage);
}
function isBriefingMore(value) {
  return isRecord9(value) && Number.isSafeInteger(value.plannedToday) && value.plannedToday >= 0 && Number.isSafeInteger(value.overdue) && value.overdue >= 0 && Number.isSafeInteger(value.open) && value.open >= 0;
}
function isBriefingTask(value) {
  return isRecord9(value) && typeof value.code === "string" && typeof value.title === "string" && typeof value.status === "string" && ["backlog", "todo", "doing", "done", "dropped"].includes(value.status) && typeof value.priority === "number" && Number.isInteger(value.priority) && value.priority >= 0 && value.priority <= 4 && typeof value.estimateMin === "number" && Number.isFinite(value.estimateMin) && value.estimateMin >= 0 && (value.plannedFor === null || typeof value.plannedFor === "string") && (value.dueOn === null || typeof value.dueOn === "string");
}
function stageLabel(stage) {
  const labels = { idea: "\u6784\u601D\u4E2D", building: "\u642D\u5EFA\u4E2D", running: "\u8FD0\u8425\u4E2D", paused: "\u6682\u505C", ended: "\u5DF2\u7ED3\u675F" };
  return labels[stage] ?? String(stage);
}
function priorityLabel(priority) {
  return ["\u65E0", "\u4F4E", "\u4E2D", "\u9AD8", "\u7D27\u6025"][priority] ?? "\u65E0";
}
function isRecord9(value) {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

// integrations/recorder/src/sync/spawn.ts
var import_node_fs13 = require("node:fs");
var import_node_child_process2 = require("node:child_process");
var import_node_path14 = require("node:path");
var MAX_DELAY_MS = 20 * 6e4;
var DEDUPE_WINDOW_MS = 3e4;
var RETAIN_AFTER_DUE_MS = 5 * 6e4;
function spawnBackgroundSync(execPath, scriptPath, env, options = {}) {
  const delayMs = options.delayMs === void 0 ? void 0 : Math.max(0, Math.min(MAX_DELAY_MS, options.delayMs));
  const home = recorderHome(env);
  const dueAt = delayMs ? Date.now() + delayMs : void 0;
  let reservation;
  if (delayMs && dueAt !== void 0) {
    if (!reserveSettleSlot(home, dueAt)) return;
    reservation = (0, import_node_path14.join)(home, `settle-${dueAt}.lock`);
  }
  try {
    const args = [scriptPath, "sync", ...delayMs ? ["--delay", String(delayMs)] : []];
    const childEnv = {
      ...env,
      ...reservation ? { DEVERDESK_RECORDER_SETTLE_LOCK: reservation } : {}
    };
    (0, import_node_fs13.mkdirSync)(home, { recursive: true });
    const child = (0, import_node_child_process2.spawn)(execPath, args, { detached: true, stdio: "ignore", windowsHide: true, env: childEnv, cwd: home });
    child.once("error", (error) => {
      releaseReservation();
      try {
        options.onError?.(error);
      } catch {
      }
    });
    child.unref();
  } catch (error) {
    releaseReservation();
    throw error;
  }
  function releaseReservation() {
    if (!reservation) return;
    try {
      (0, import_node_fs13.unlinkSync)(reservation);
    } catch {
    }
  }
}
function reserveSettleSlot(home, dueAt) {
  (0, import_node_fs13.mkdirSync)(home, { recursive: true });
  const gate = (0, import_node_path14.join)(home, "settle-index.lock");
  let descriptor = openGate(gate);
  if (descriptor === null) {
    try {
      if (Date.now() - (0, import_node_fs13.statSync)(gate).mtimeMs > 1e4) (0, import_node_fs13.unlinkSync)(gate);
    } catch {
      return false;
    }
    descriptor = openGate(gate);
    if (descriptor === null) return false;
  }
  try {
    for (const name of (0, import_node_fs13.readdirSync)(home)) {
      const match = /^settle-(\d+)\.lock$/.exec(name);
      if (!match?.[1]) continue;
      const existingDue = Number(match[1]);
      const path = (0, import_node_path14.join)(home, name);
      if (existingDue + RETAIN_AFTER_DUE_MS < Date.now()) {
        try {
          (0, import_node_fs13.unlinkSync)(path);
        } catch {
        }
      } else if (Math.abs(existingDue - dueAt) <= DEDUPE_WINDOW_MS) {
        return false;
      }
    }
    const reservation = (0, import_node_path14.join)(home, `settle-${dueAt}.lock`);
    let lock;
    try {
      lock = (0, import_node_fs13.openSync)(reservation, "wx");
    } catch {
      return false;
    }
    (0, import_node_fs13.writeSync)(lock, `${process.pid} ${dueAt}
`);
    (0, import_node_fs13.closeSync)(lock);
    return true;
  } finally {
    (0, import_node_fs13.closeSync)(descriptor);
    try {
      (0, import_node_fs13.unlinkSync)(gate);
    } catch {
    }
  }
}
function openGate(path) {
  let descriptor;
  try {
    descriptor = (0, import_node_fs13.openSync)(path, "wx");
  } catch {
    return null;
  }
  try {
    (0, import_node_fs13.writeSync)(descriptor, `${process.pid} ${Date.now()}
`);
    return descriptor;
  } catch {
    (0, import_node_fs13.closeSync)(descriptor);
    try {
      (0, import_node_fs13.unlinkSync)(path);
    } catch {
    }
    return null;
  }
}

// integrations/recorder/src/commands/hook.ts
var DAY_MS3 = 24 * 60 * 6e4;
var SYNC_THROTTLE_MS = 6e4;
var LOG_MAX_BYTES = 256 * 1024;
var HOOK_EVENTS = /* @__PURE__ */ new Set(["SessionStart", "UserPromptSubmit", "Stop", "SessionEnd", "PostToolUse"]);
async function runHook({ agent, eventName, input, env, now = Date.now(), deps = {} }) {
  const home = deps.home ?? recorderHome(env);
  const log = deps.log ?? appendRecorderLog;
  const report = (message) => {
    try {
      log(home, message);
    } catch {
    }
  };
  try {
    if (env.DEVERDESK_RECORDER_INTERNAL === "1") return {};
    const payload = parseInput(input);
    const parsed = agent === "claude-code" ? parseClaudeCodeHook(eventName, payload, env) : parseCodexHook(eventName, payload);
    if (!parsed) {
      report(`Skipped ${agent} ${eventName}: missing required hook fields`);
      return {};
    }
    if (!HOOK_EVENTS.has(eventName)) {
      report(`Skipped ${agent} ${eventName}: unsupported hook event`);
      return {};
    }
    const referenceCwd = agent === "claude-code" ? env.CLAUDE_PROJECT_DIR?.trim() || parsed.cwd : parsed.cwd;
    const initialState = readState(home);
    const cached = initialState.dirCache[referenceCwd];
    const resolved = cached && now - cached.at >= 0 && now - cached.at < DAY_MS3 ? { dir: cached.dir, repo: cached.repo } : await (deps.resolveDir ?? ((cwd) => resolveDirName(cwd, deps.git ?? createGitRunner())))(referenceCwd);
    const dir = resolved.dir;
    const git = deps.git ?? createGitRunner();
    const events = [];
    const addEvent = (event) => {
      appendEvent(home, event);
      events.push(event);
    };
    const base = { v: 1, t: now, agent, session: parsed.session, dir, cwd: parsed.cwd };
    const promptTextAllowed = isPromptTextAllowed(home, env);
    if (eventName === "SessionStart") {
      addEvent({ ...base, kind: "start", ...parsed.source ? { source: parsed.source } : {}, ...resolved.repo ? { repo: resolved.repo } : {} });
    } else if (eventName === "UserPromptSubmit") {
      addEvent({ ...base, kind: "prompt", ...promptTextAllowed && parsed.text ? { text: parsed.text } : {} });
    } else if (eventName === "Stop") {
      addEvent({ ...base, kind: "stop", ...promptTextAllowed && parsed.summary ? { summary: parsed.summary } : {} });
    } else if (eventName === "SessionEnd") {
      addEvent({ ...base, kind: "end", ...parsed.reason ? { reason: parsed.reason } : {} });
    }
    let newCommits = [];
    if (shouldDiscoverCommits(eventName, parsed)) {
      const worktreeRoot = await findWorktreeRoot(git, referenceCwd);
      if (worktreeRoot) {
        const hasBaseline = initialState.repos[worktreeRoot] !== void 0;
        const sessionStartMs = eventName === "SessionStart" || hasBaseline ? void 0 : findSessionStart(initialState, agent, parsed.session) ?? now;
        newCommits = await detectNewCommitsLocked(home, git, worktreeRoot, sessionStartMs, (commits) => {
          for (const commit of commits) addEvent(toCommitEvent(commit, base, resolved.repo ?? worktreeRoot, now));
        });
      }
    }
    await updateState(home, (state) => {
      const key = sessionStartKey(agent, parsed.session);
      if (!state.sessionStarts[key]) {
        state.sessionStarts[key] = { agent, session: parsed.session, at: now };
        trimSessionStarts(state.sessionStarts);
      }
      if (events.length > 0 && state.firstLiveEvent[agent] === void 0) {
        state.firstLiveEvent[agent] = events[0]?.t ?? now;
      }
      state.lastHook = { at: now, agent, event: eventName, session: parsed.session };
      if (!cached || now - cached.at < 0 || now - cached.at >= DAY_MS3) {
        state.dirCache[referenceCwd] = { dir, ...resolved.repo ? { repo: resolved.repo } : {}, at: now };
      }
    });
    const currentState = readState(home);
    const spawnSync = deps.spawnSync ?? ((options = {}) => {
      spawnBackgroundSync(process.execPath, process.argv[1] ?? "", env, {
        ...options,
        onError: (error) => report(`Background sync spawn failed: ${error.message}`)
      });
    });
    const spawnDelayed = (delayMs) => {
      if (env.DEVERDESK_NO_DELAYED_SYNC === "1") return;
      spawnSync({ delayMs });
    };
    if (eventName === "UserPromptSubmit") {
      if (!wasRecentlySynced(currentState.lastSync?.startedAt, now)) spawnSync();
    } else if (eventName === "Stop") {
      if (newCommits.length > 0 || !wasRecentlySynced(currentState.lastSync?.startedAt, now)) spawnSync();
      if (newCommits.length > 0) spawnDelayed(delayUntilCommitSettles(newCommits, now));
    } else if (eventName === "SessionEnd") {
      spawnSync();
      spawnDelayed(SETTLE_DELAY);
    } else if (eventName === "PostToolUse" && newCommits.length > 0) {
      spawnDelayed(delayUntilCommitSettles(newCommits, now));
    }
    if (eventName === "SessionStart") {
      const credentials = loadCredentials(home, env);
      if (credentials && isDirectoryBound(home, dir)) {
        const briefing = await (deps.fetchBriefing ?? ((creds, name, options) => fetchBriefing(creds, name, options)))(
          credentials,
          dir,
          { timeoutMs: 800, home, now }
        );
        if (briefing) {
          const text = formatBriefing(briefing);
          if (text) return { stdout: JSON.stringify({ hookSpecificOutput: { hookEventName: "SessionStart", additionalContext: text } }) };
        }
      }
    }
    return {};
  } catch (error) {
    report(errorMessage2(error));
    return {};
  }
}
function parseInput(input) {
  if (Buffer.isBuffer(input)) return JSON.parse(input.toString("utf8"));
  if (typeof input === "string") return JSON.parse(input);
  return input;
}
function shouldDiscoverCommits(eventName, parsed) {
  return eventName === "SessionStart" || eventName === "Stop" || eventName === "SessionEnd" || eventName === "PostToolUse" && parsed.commitCommand === true;
}
async function findWorktreeRoot(git, cwd) {
  const result = await git.run(["-C", cwd, "rev-parse", "--show-toplevel"], cwd);
  if (!result.ok || !result.stdout.trim()) return void 0;
  return result.stdout.trim().replace(/\\/g, "/").replace(/\/+$/, "");
}
function findSessionStart(state, agent, session) {
  const cached = state.sessionStarts[sessionStartKey(agent, session)];
  return cached?.agent === agent && cached.session === session ? cached.at : void 0;
}
function sessionStartKey(agent, session) {
  return JSON.stringify([agent, session]);
}
function trimSessionStarts(starts) {
  const entries = Object.entries(starts);
  if (entries.length <= 1e3) return;
  entries.sort((left, right) => left[1].at - right[1].at);
  for (const [key] of entries.slice(0, entries.length - 1e3)) delete starts[key];
}
function toCommitEvent(commit, base, repo, seenAt) {
  return {
    ...base,
    t: commit.committedAt,
    seenAt,
    kind: "commit",
    repo,
    sha: commit.sha,
    subject: commit.subject,
    ...commit.body ? { body: commit.body.slice(0, 500) } : {},
    additions: commit.additions,
    deletions: commit.deletions,
    files: commit.files,
    authoredAt: commit.authoredAt
  };
}
function delayUntilCommitSettles(commits, now) {
  const nextArrival = Math.min(...commits.map((commit) => commit.committedAt + SETTLE_DELAY));
  return Math.max(0, nextArrival - now);
}
function wasRecentlySynced(startedAt, now) {
  return startedAt !== void 0 && now - startedAt <= SYNC_THROTTLE_MS;
}
function isDirectoryBound(home, dir) {
