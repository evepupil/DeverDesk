  if (!title) throw invalidTitle();
  const now = dependencies.now ?? Date.now();
  const resolved = await dependencies.resolveDirName(dependencies.cwd);
  const events = (dependencies.readEvents ?? readEvents)(dependencies.home, { now });
  const recent = events.filter((event2) => event2.dir !== void 0 && dirNameKey(event2.dir) === dirNameKey(resolved.dir) && event2.session.length > 0).sort((left, right) => right.t - left.t)[0];
  const environmentSession = dependencies.env.CLAUDE_CODE_SESSION_ID;
  const session = options.session || environmentSession || recent?.session || `manual-${new Date(now).toISOString().slice(0, 10)}`;
  const agent = options.agent ?? (environmentSession ? "claude-code" : recent?.agent ?? "codex");
  const event = {
    v: 1,
    t: now,
    agent,
    session,
    dir: resolved.dir,
    cwd: dependencies.cwd,
    kind: "done",
    title
  };
  (dependencies.appendEvent ?? appendEvent)(dependencies.home, event);
  if (loadCredentials(dependencies.home, dependencies.env)) dependencies.spawnBackgroundSync();
  return `\u5DF2\u8BB0\u4E0B\uFF1A${title}`;
}

