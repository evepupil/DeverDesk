// integrations/recorder/src/agents/text.ts
var SENTENCE_END = /* @__PURE__ */ new Set(["\u3002", "\uFF01", "\uFF1F", ".", "!", "?"]);
function firstSentence2(text, max) {
  if (typeof text !== "string" || max <= 0) return void 0;
  let start = 0;
  const candidates = [];
  for (let index = 0; index < text.length; index += 1) {
    const character = text[index];
    if (character === "\n" || character === "\r" || character !== void 0 && SENTENCE_END.has(character)) {
      const end = character === "\n" || character === "\r" ? index : index + 1;
      candidates.push(text.slice(start, end));
      if (character === "\r" && text[index + 1] === "\n") index += 1;
      start = index + 1;
    }
  }
  if (start < text.length) candidates.push(text.slice(start));
  for (const candidate of candidates) {
    const trimmed = candidate.trim();
    if (!trimmed || trimmed.startsWith("/")) continue;
    return Array.from(trimmed).slice(0, Math.floor(max)).join("");
  }
  return void 0;
}

// integrations/recorder/src/agents/claude-code.ts
function parseClaudeCodeHook(eventName, payload, env = process.env) {
  if (!isRecord7(payload)) return null;
  const session = requiredString(payload.session_id);
  const cwd = requiredString(payload.cwd) ?? requiredString(env.CLAUDE_PROJECT_DIR);
  if (!session || !cwd) return null;
  const parsed = { session, cwd };
  if (eventName === "SessionStart") {
    const source = optionalString(payload.source);
    if (source) parsed.source = source;
  } else if (eventName === "UserPromptSubmit") {
    parsed.text = firstSentence2(payload.prompt, 120);
  } else if (eventName === "Stop") {
    parsed.summary = firstSentence2(payload.last_assistant_message, 200);
  } else if (eventName === "SessionEnd") {
    const reason = optionalString(payload.reason);
    if (reason) parsed.reason = reason;
  } else if (eventName === "PostToolUse") {
    const toolInput = isRecord7(payload.tool_input) ? payload.tool_input : void 0;
    const command = typeof toolInput?.command === "string" ? toolInput.command : "";
    if (payload.tool_name !== "Bash" || !/\bgit\b/i.test(command) || !/\bcommit\b/i.test(command)) return null;
    parsed.commitCommand = true;
  }
  return parsed;
}
