{
  "name": "deverdesk",
  "version": "0.1.0",
  "private": true,
  "description": "独立开发者的一人公司控制台：任务、时间和副业收支放在一起",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/evepupil/DeverDesk"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev.mjs --local",
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build.mjs --edition local",
    "deploy": "node scripts/deploy.mjs",
    "deploy:demo": "node scripts/build.mjs --edition local && wrangler deploy -c deploy/demo/wrangler.jsonc",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "shots": "node scripts/acceptance/shots.mjs",
    "probe": "node scripts/acceptance/probe.mjs",
    "e2e": "node scripts/acceptance/e2e-cloud.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.1"
  }
}
